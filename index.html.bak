    {
      "poem": "乞巧补充：七夕今宵看碧霄",
      "author": "林杰",
      "dynasty": "唐",
      "audios": [],
      "videos": [],
      "content": "七夕今宵看碧霄，牵牛织女渡河桥。\n家家乞巧望秋月，穿尽红丝几万条。"
    },
    {
      "poem": "己亥杂诗·浩荡离愁白日斜",
      "author": "龚自珍",
      "dynasty": "清",
      "audios": [],
      "videos": [],
      "content": "浩荡离愁白日斜，吟鞭东指即天涯。\n落红不是无情物，化作春泥更护花。"
    },
    {
      "poem": "题西林壁",
      "author": "苏轼",
      "dynasty": "宋",
      "audios": [],
      "videos": [],
      "content": "横看成岭侧成峰，远近高低各不同。\n不识庐山真面目，只缘身在此山中。"
    },
    {
      "poem": "马诗·大漠沙如雪",
      "author": "李贺",
      "dynasty": "唐",
      "audios": [],
      "videos": [],
      "content": "大漠沙如雪，燕山月似钩。\n何当金络脑，快走踏清秋。"
    },
    {
      "poem": "乌衣巷",
      "author": "刘禹锡",
      "dynasty": "唐",
      "audios": [],
      "videos": [],
      "content": "朱雀桥边野草花，乌衣巷口夕阳斜。\n旧时王谢堂前燕，飞入寻常百姓家。"
    },
    {
      "poem": "秋夕",
      "author": "杜牧",
      "dynasty": "唐",
      "audios": [],
      "videos": [],
      "content": "银烛秋光冷画屏，轻罗小扇扑流萤。\n天阶夜色凉如水，卧看牵牛织女星。"
    },
    {
      "poem": "商山早行",
      "author": "温庭筠",
      "dynasty": "唐",
      "audios": [],
      "videos": [],
      "content": "晨起动征铎，客行悲故乡。\n鸡声茅店月，人迹板桥霜。\n槲叶落山路，枳花明驿墙。\n因思杜陵梦，凫雁满回塘。"
    },
    {
      "poem": "四时田园杂兴（其三十一）",
      "author": "范成大",
      "dynasty": "宋",
      "content": "昼出耘田夜绩麻，\n村庄儿女各当家。\n童孙未解供耕织，\n也傍桑阴学种瓜。",
      "audios": [],
      "videos": []
    },
    {
      "poem": "杨氏之子",
      "author": "刘义庆",
      "dynasty": "南朝宋",
      "content": "梁国杨氏子九岁，甚聪惠。\n孔君平诣其父，父不在，乃呼儿出。\n为设果，果有杨梅。\n孔指以示儿曰：\"此是君家果。\"\n儿应声答曰：\"未闻孔雀是夫子家禽。\"",
      "audios": [],
      "videos": []
    },
    {
      "poem": "渔歌子",
      "author": "张志和",
      "dynasty": "唐",
      "content": "西塞山前白鹭飞，\n桃花流水鳜鱼肥。\n青箬笠，绿蓑衣，\n斜风细雨不须归。",
      "audios": [],
      "videos": []
    },
    {
      "poem": "游子吟",
      "author": "孟郊",
      "dynasty": "唐",
      "content": "慈母手中线，\n游子身上衣。\n临行密密缝，\n意恐迟迟归。\n谁言寸草心，\n报得三春晖。",
      "audios": [],
      "videos": []
    },
    {
      "poem": "蝉",
      "author": "虞世南",
      "dynasty": "唐",
      "content": "垂緌饮清露，\n流响出疏桐。\n居高声自远，\n非是藉秋风。",
      "audios": [],
      "videos": []
    },
    {
      "poem": "观书有感（其一）",
      "author": "朱熹",
      "dynasty": "宋",
      "content": "半亩方塘一鉴开，\n天光云影共徘徊。\n问渠那得清如许？\n为有源头活水来。",
      "audios": [],
      "videos": []
    },
    {
      "poem": "鸟鸣涧",
      "author": "王维",
      "dynasty": "唐",
      "content": "人闲桂花落，\n夜静春山空。\n月出惊山鸟，\n时鸣春涧中。",
      "audios": [],
      "videos": []
    },
    {
      "poem": "黄鹤楼送孟浩然之广陵",
      "author": "李白",
      "dynasty": "唐",
      "content": "故人西辞黄鹤楼，\n烟花三月下扬州。\n孤帆远影碧空尽，\n唯见长江天际流。",
      "audios": [],
      "videos": []
    }
  ],
