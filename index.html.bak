    {
      "poem": "十五夜望月寄杜郎中",
      "author": "王建",
      "dynasty": "唐",
      "audios": [],
      "videos": [],
      "content": "中庭地白树栖鸦，冷露无声湿桂花。\n今夜月明人尽望，不知秋思落谁家。"
    },
    {
      "poem": "竹枝词·杨柳青青江水平",
      "author": "刘禹锡",
      "dynasty": "唐",
      "audios": [],
      "videos": [],
      "content": "杨柳青青江水平，闻郎江上唱歌声。\n东边日出西边雨，道是无晴却有晴。"
    },
    {
      "poem": "相见欢·无言独上西楼",
      "author": "李煜",
      "dynasty": "五代",
      "audios": [],
      "videos": [],
      "content": "无言独上西楼，月如钩。\n寂寞梧桐深院锁清秋。\n剪不断，理还乱，是离愁。\n别是一般滋味在心头。"
    },
    {
      "poem": "如梦令·常记溪亭日暮",
      "author": "李清照",
      "dynasty": "宋",
      "audios": [],
      "videos": [],
      "content": "常记溪亭日暮，沉醉不知归路。\n兴尽晚回舟，误入藕花深处。\n争渡，争渡，惊起一滩鸥鹭。"
    },
    {
      "poem": "过零丁洋",
      "author": "文天祥",
      "dynasty": "宋",
      "audios": [],
      "videos": [],
      "content": "辛苦遭逢起一经，干戈寥落四周星。\n山河破碎风飘絮，身世浮沉雨打萍。\n惶恐滩头说惶恐，零丁洋里叹零丁。\n人生自古谁无死？留取丹心照汗青。"
    },
    {
      "poem": "天净沙·秋思",
      "author": "马致远",
      "dynasty": "元",
      "audios": [],
      "videos": [],
      "content": "枯藤老树昏鸦，小桥流水人家，\n古道西风瘦马。\n夕阳西下，断肠人在天涯。"
    },
    {
      "poem": "山坡羊·潼关怀古",
      "author": "张养浩",
      "dynasty": "元",
      "audios": [],
      "videos": [],
      "content": "峰峦如聚，波涛如怒，山河表里潼关路。\n望西都，意踌躇。\n伤心秦汉经行处，宫阙万间都做了土。\n兴，百姓苦；亡，百姓苦。"
    },
    {
      "poem": "两小儿辩日",
      "author": "列子",
      "dynasty": "先秦",
      "content": "孔子东游，见两小儿辩斗，问其故。\n一儿曰：\"我以日始出时去人近，而日中时远也。\"\n一儿曰：\"日初出远，而日中时近也。\"\n一儿曰：\"日初出大如车盖，及日中则如盘盂，此不为远者小而近者大乎？\"\n一儿曰：\"日初出沧沧凉凉，及其日中如探汤，此不为近者热而远者凉乎？\"\n孔子不能决也。两小儿笑曰：\"孰为汝多知乎？\"",
      "audios": [],
      "videos": []
    },
    {
      "poem": "卜算子·送鲍浩然之浙东",
      "author": "王观",
      "dynasty": "宋",
      "content": "水是眼波横，山是眉峰聚。\n欲问行人去那边？眉眼盈盈处。\n才始送春归，又送君归去。\n若到江南赶上春，千万和春住。",
      "audios": [],
      "videos": []
    },
    {
      "poem": "学弈",
      "author": "孟子",
      "dynasty": "先秦",
      "content": "弈秋，通国之善弈者也。\n使弈秋诲二人弈，其一人专心致志，惟弈秋之为听；\n一人虽听之，一心以为有鸿鹄将至，思援弓缴而射之。\n虽与之俱学，弗若之矣。为是其智弗若与？曰：非然也。",
      "audios": [],
      "videos": []
    },
    {
      "poem": "早莺呈水部张十八员外",
      "author": "韩愈",
      "dynasty": "唐",
      "content": "天街小雨润如酥，\n草色遥看近却无。\n最是一年春好处，\n绝胜烟柳满皇都。",
      "audios": [],
      "videos": []
    },
    {
      "poem": "春夜喜雨",
      "author": "杜甫",
      "dynasty": "唐",
      "content": "好雨知时节，\n当春乃发生。\n随风潜入夜，\n润物细无声。\n野径云俱黑，\n江船火独明。\n晓看红湿处，\n花重锦官城。",
      "audios": [],
      "videos": []
    },
    {
      "poem": "春日",
      "author": "朱熹",
      "dynasty": "宋",
      "content": "胜日寻芳泗水滨，\n无边光景一时新。\n等闲识得东风面，\n万紫千红总是春。",
      "audios": [],
      "videos": []
    },
    {
      "poem": "江上渔者",
      "author": "范仲淹",
      "dynasty": "宋",
      "content": "江上往来人，\n但爱鲈鱼美。\n君看一舟人，\n出没风波里。",
      "audios": [],
      "videos": []
    },
    {
      "poem": "泊船瓜洲",
      "author": "王安石",
      "dynasty": "宋",
      "content": "京口瓜洲一水间，\n钟山只隔数重山。\n春风又绿江南岸，\n明月何时照我还。",
      "audios": [],
      "videos": []
    },
    {
      "poem": "浣溪沙",
      "author": "苏轼",
      "dynasty": "宋",
      "content": "山下兰芽短浸溪，\n松间沙路净无泥，\n萧萧暮雨子规啼。\n谁道人生无再少？\n门前流水尚能西！\n休将白发唱黄鸡。",
      "audios": [],
      "videos": []
    },
    {
      "poem": "菩萨蛮·大柏地",
      "author": "毛泽东",
      "dynasty": "近代",
      "content": "赤橙黄绿青蓝紫，\n谁持彩练当空舞？\n雨后复斜阳，\n关山阵阵苍。\n当年鏖战急，\n弹洞前村壁。\n装点此关山，\n今朝更好看。",
      "audios": [],
      "videos": []
    },
    {
      "poem": "过故人庄",
      "author": "孟浩然",
      "dynasty": "唐",
      "content": "故人具鸡黍，\n邀我至田家。\n绿树村边合，\n青山郭外斜。\n开轩面场圃，\n把酒话桑麻。\n待到重阳日，\n还来就菊花。",
      "audios": [],
      "videos": []
    },
    {
      "poem": "送元二使安西",
      "author": "王维",
      "dynasty": "唐",
      "content": "渭城朝雨浥轻尘，\n客舍青青柳色新。\n劝君更尽一杯酒，\n西出阳关无故人。",
      "audios": [],
      "videos": []
    }
  ],
