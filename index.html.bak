<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>吟诵学堂</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=ZCOOL+XiaoWei&family=Long+Cang&display=swap');
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
  :root{
    --paper:#f0e6d2;--paper-light:#f7f0e0;--ink:#2b1d0e;--ink-light:#5a3e1b;
    --vermilion:#a8261e;--vermilion-deep:#8b1a13;--gold:#a67c00;
    --border:#7a6440;--shadow:rgba(43,29,14,0.2);--seal-red:#b22222;
  }
  body{
    font-family:'ZCOOL XiaoWei','KaiTi','楷体',serif;
    background:linear-gradient(180deg,#f0e6d2 0%,#e8dcc0 40%,#dccda8 100%);
    color:var(--ink);min-height:100vh;line-height:1.8;position:relative;overflow-x:hidden;
  }
  body::before{
    content:'';position:fixed;top:0;left:0;right:0;bottom:0;
    background-image:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(122,100,64,0.02) 3px,rgba(122,100,64,0.02) 5px),
    repeating-linear-gradient(90deg,transparent,transparent 7px,rgba(122,100,64,0.015) 7px,rgba(122,100,64,0.015) 9px);
    pointer-events:none;z-index:0;
  }
  .container{max-width:900px;margin:0 auto;position:relative;z-index:1;padding-bottom:40px;}

  /* === 视图切换 === */
  .view{display:none;padding:0 14px 20px;position:relative;z-index:1;}
  .view.active{display:block;animation:fadeIn 0.2s;}
  @keyframes fadeIn{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}

  /* === 顶栏 === */
  .topbar{
    position:sticky;top:0;z-index:100;background:rgba(240,230,210,0.96);backdrop-filter:blur(8px);
    border-bottom:1px solid var(--border);margin:0 -14px 14px;padding:10px 14px;
    display:flex;align-items:center;gap:10px;
  }
  .topbar .title{
    font-family:'Ma Shan Zheng','KaiTi',cursive;font-size:18px;color:var(--ink);letter-spacing:2px;flex:1;
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  }
  .topbar .back{
    background:var(--ink);color:var(--paper);border:none;border-radius:2px;padding:7px 12px;
    font-family:'Ma Shan Zheng',serif;font-size:14px;cursor:pointer;letter-spacing:1px;white-space:nowrap;
  }
  .topbar .back:active{background:var(--vermilion-deep);}
  .topbar .count{font-size:12px;color:var(--ink-light);white-space:nowrap;}

  /* === 首页 Header === */
  .home-header{
    text-align:center;padding:28px 16px 20px;margin-bottom:12px;
    background:linear-gradient(180deg,rgba(247,240,224,0.92),rgba(232,220,192,0.85));
    border-bottom:1px solid var(--border);
  }
  .home-header h1{
    font-family:'Ma Shan Zheng',cursive;font-size:34px;color:var(--ink);letter-spacing:8px;margin-bottom:4px;
    text-shadow:1px 1px 0 rgba(168,38,30,0.12);
  }
  .home-header .sub{font-size:13px;color:var(--ink-light);letter-spacing:4px;font-family:'Long Cang',cursive;}
  .home-header .seal{
    display:inline-block;background:var(--seal-red);color:#fff;padding:3px 10px;font-size:11px;
    border-radius:1px;margin-top:6px;letter-spacing:3px;font-family:'Ma Shan Zheng',serif;transform:rotate(-2deg);
    box-shadow:inset 0 0 0 1px rgba(255,255,255,0.2);
  }

  /* === 搜索 === */
  .search-wrap{margin-bottom:12px;}
  .search-wrap input{
    width:100%;padding:10px 14px;font-size:15px;font-family:inherit;
    background:rgba(255,252,240,0.7);border:1px solid var(--border);border-radius:2px;
    color:var(--ink);outline:none;box-shadow:inset 0 1px 3px rgba(122,100,64,0.1);
  }
  .search-wrap input:focus{border-color:var(--vermilion);box-shadow:0 0 0 2px rgba(168,38,30,0.1);}
  .search-wrap input::placeholder{color:var(--ink-light);opacity:0.5;}

  /* === 分类网格 === */
  .cat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
  .cat-card{
    background:linear-gradient(145deg,rgba(255,252,240,0.75),rgba(240,230,210,0.85));
    border:1px solid var(--border);border-radius:2px;padding:12px 6px;cursor:pointer;
    transition:all 0.2s;position:relative;text-align:center;box-shadow:0 1px 4px var(--shadow);
  }
  .cat-card::before{
    content:'';position:absolute;top:3px;left:3px;right:3px;bottom:3px;
    border:1px solid rgba(122,100,64,0.18);pointer-events:none;
  }
  .cat-card:active{transform:scale(0.95);border-color:var(--vermilion);}
  .cat-card .cn{font-family:'Ma Shan Zheng',cursive;font-size:16px;color:var(--ink);letter-spacing:1px;margin-bottom:2px;line-height:1.3;}
  .cat-card .cc{font-size:11px;color:var(--ink-light);}
  .cat-card .cc .num{color:var(--vermilion);font-weight:bold;}
  .cat-card.has-video::after{content:'🎬';position:absolute;top:4px;right:5px;font-size:9px;opacity:0.5;}
  .cat-card.cat-all{background:linear-gradient(135deg,var(--vermilion),var(--vermilion-deep));border-color:var(--vermilion-deep);}
  .cat-card.cat-all .cn{color:#fff;font-size:17px;}
  .cat-card.cat-all .cc{color:rgba(255,255,255,0.85);}
  .cat-card.cat-all .cc .num{color:#ffd700;}
  .cat-card.cat-all::before{border-color:rgba(255,255,255,0.2);}

  /* === 搜索结果 === */
  .sr-list{display:flex;flex-direction:column;gap:6px;margin-bottom:10px;}
  .sr-item{
    display:flex;justify-content:space-between;align-items:center;padding:10px 14px;
    background:rgba(255,252,240,0.6);border:1px solid var(--border);border-radius:2px;
    cursor:pointer;transition:all 0.2s;
  }
  .sr-item:active{background:rgba(168,38,30,0.08);border-color:var(--vermilion);}
  .sr-name{font-family:'Ma Shan Zheng',cursive;font-size:17px;color:var(--ink);}
  .sr-cat{font-size:11px;color:var(--vermilion);background:rgba(168,38,30,0.08);padding:2px 7px;border-radius:1px;}
  .no-data{text-align:center;padding:30px 20px;color:var(--ink-light);font-size:14px;}

  /* === 目录页（二级） === */
  .catalog{display:flex;flex-direction:column;gap:4px;}
  .cat-item{
    display:flex;justify-content:space-between;align-items:center;
    padding:12px 14px;background:rgba(255,252,240,0.5);
    border:1px solid var(--border);border-radius:2px;cursor:pointer;
    transition:all 0.15s;position:relative;
  }
  .cat-item:active{background:rgba(168,38,30,0.08);border-color:var(--vermilion);transform:translateX(3px);}
  .cat-item .ci-name{font-family:'Ma Shan Zheng',cursive;font-size:18px;color:var(--ink);letter-spacing:1px;}
  .cat-item .ci-meta{display:flex;gap:6px;align-items:center;font-size:12px;color:var(--ink-light);}
  .cat-item .ci-arrow{color:var(--vermilion);font-size:14px;opacity:0.5;}
  .cat-item .ci-video{font-size:12px;}
  .cat-item .ci-num{
    display:inline-block;background:var(--ink);color:var(--paper);
    font-size:10px;padding:1px 6px;border-radius:1px;margin-left:4px;
  }
  .cat-item.hidden{display:none;}

  /* === 分页 === */
  .pagination{
    display:flex;justify-content:center;align-items:center;gap:8px;margin-top:16px;padding:10px 0;
  }
  .pagination button{
    background:rgba(255,252,240,0.7);border:1px solid var(--border);border-radius:2px;
    padding:6px 14px;font-family:inherit;font-size:13px;color:var(--ink);cursor:pointer;
  }
  .pagination button:disabled{opacity:0.4;cursor:not-allowed;}
  .pagination button:not(:disabled):active{background:var(--vermilion);color:#fff;border-color:var(--vermilion);}
  .pagination .pg-info{font-size:12px;color:var(--ink-light);}

  /* === 诗词详情页（三级） === */
  .poem-detail{
    background:linear-gradient(145deg,rgba(255,252,240,0.75),rgba(240,230,210,0.85));
    border:1px solid var(--border);border-radius:2px;padding:16px;margin-bottom:14px;
    position:relative;box-shadow:0 1px 6px var(--shadow);
  }
  .poem-detail::before{
    content:'';position:absolute;top:4px;left:4px;right:4px;bottom:4px;
    border:1px solid rgba(122,100,64,0.2);pointer-events:none;
  }
  .poem-detail h2{
    font-family:'Ma Shan Zheng',cursive;font-size:26px;color:var(--ink);
    text-align:center;letter-spacing:3px;margin-bottom:12px;text-shadow:1px 1px 0 rgba(168,38,30,0.1);
  }
  .poem-detail .meta-row{text-align:center;font-size:12px;color:var(--ink-light);margin-bottom:14px;}
  .poem-detail .meta-row .dot{margin:0 6px;opacity:0.4;}

  .audio-group{margin-bottom:14px;}
  .audio-group .ag-label{
    font-size:13px;color:var(--ink-light);margin-bottom:8px;padding-left:6px;
    border-left:3px solid var(--vermilion);letter-spacing:2px;
  }
  .audio-btns{display:flex;flex-wrap:wrap;gap:6px;}
  .audio-btn{
    display:flex;align-items:center;gap:5px;padding:7px 13px;
    background:linear-gradient(180deg,rgba(255,252,240,0.7),rgba(232,220,192,0.6));
    border:1px solid var(--border);border-radius:1px;cursor:pointer;
    font-size:13px;color:var(--ink);user-select:none;transition:all 0.2s;
  }
  .audio-btn:active{background:var(--vermilion);color:#fff;border-color:var(--vermilion-deep);}
  .audio-btn.playing{background:var(--ink);color:var(--paper);border-color:var(--ink);animation:pulse 1.5s infinite;}
  .audio-btn .btn-state{
    margin-left:6px;font-size:10px;color:var(--vermilion);opacity:0.7;
    width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center;
    background:rgba(168,38,30,0.1);border-radius:1px;
  }
  .audio-btn.playing .btn-state{color:#fff;background:rgba(255,255,255,0.2);opacity:1;}
  @keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(168,38,30,0.3);}50%{box-shadow:0 0 0 6px rgba(168,38,30,0);}}

  /* 视频折叠 */
  .video-collapse{border:1px solid var(--border);border-radius:2px;margin-top:4px;overflow:hidden;}
  .video-header{
    display:flex;justify-content:space-between;align-items:center;
    padding:10px 14px;background:rgba(255,252,240,0.5);cursor:pointer;
    font-size:14px;color:var(--ink);letter-spacing:1px;
  }
  .video-header:active{background:rgba(168,38,30,0.05);}
  .video-header .vh-title{display:flex;align-items:center;gap:6px;}
  .video-header .vh-arrow{transition:transform 0.25s;font-size:12px;color:var(--ink-light);}
  .video-collapse.open .video-header .vh-arrow{transform:rotate(90deg);}
  .video-body{max-height:0;overflow:hidden;transition:max-height 0.3s ease;}
  .video-collapse.open .video-body{max-height:500px;}
  .video-inner{padding:10px;background:rgba(42,42,42,0.1);}
  .video-wrapper{position:relative;width:100%;aspect-ratio:16/9;background:#2a2a2a;border-radius:1px;overflow:hidden;border:1px solid var(--ink);}
  .video-player{width:100%;height:100%;display:block;background:#2a2a2a;object-fit:contain;filter:brightness(1.08) contrast(1.05);}
  .video-overlay{
    position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
    width:56px;height:56px;background:rgba(168,38,30,0.92);border:2px solid rgba(255,255,255,0.85);
    border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:22px;cursor:pointer;z-index:3;padding-left:3px;
  }
  .video-overlay:hover{background:var(--vermilion);}
  .video-wrapper.playing .video-overlay{display:none;}

  /* 全屏按钮 */
  .fs-btn{
    position:absolute;bottom:8px;right:8px;width:36px;height:36px;
    background:rgba(0,0,0,0.55);border:1px solid rgba(255,255,255,0.3);border-radius:4px;
    display:flex;align-items:center;justify-content:center;color:#fff;font-size:16px;
    cursor:pointer;z-index:4;transition:all 0.2s;backdrop-filter:blur(4px);
  }
  .fs-btn:active{background:var(--vermilion);transform:scale(0.92);}
  .fs-btn.exit{background:rgba(168,38,30,0.85);border-color:rgba(255,255,255,0.4);}
  .fs-tip{
    position:absolute;bottom:50px;right:8px;background:rgba(0,0,0,0.75);color:#fff;
    font-size:11px;padding:4px 8px;border-radius:3px;white-space:nowrap;z-index:4;
    pointer-events:none;opacity:0;transition:opacity 0.2s;
  }
  .fs-btn:hover + .fs-tip{opacity:1;}

  /* 横屏按钮 */
  .ls-btn{
    position:absolute;bottom:8px;right:52px;width:36px;height:36px;
    background:rgba(0,0,0,0.55);border:1px solid rgba(255,255,255,0.3);border-radius:4px;
    display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px;
    cursor:pointer;z-index:4;transition:all 0.2s;backdrop-filter:blur(4px);
  }
  .ls-btn:active{background:var(--vermilion);transform:scale(0.92);}
  .ls-btn.active{background:var(--vermilion);border-color:rgba(255,255,255,0.5);}

  /* 横屏模式 - 模拟横屏旋转90度 */
  .video-wrapper.is-landscape{
    position:fixed!important;top:50%!important;left:50%!important;
    width:100vh!important;height:56.25vw!important;
    transform:translate(-50%,-50%) rotate(90deg)!important;
    z-index:9999;border:none;border-radius:0;background:#000;overflow:hidden;
    box-shadow:0 0 30px rgba(0,0,0,0.5);
  }
  .video-wrapper.is-landscape .ls-btn{
    bottom:12px;right:12px;width:40px;height:40px;font-size:16px;
    transform:rotate(-90deg);
  }
  .video-wrapper.is-landscape .fs-btn{display:none;}
  .video-wrapper.is-landscape .video-overlay{
    transform:translate(-50%,-50%) rotate(-90deg);
  }
  .video-wrapper.is-landscape .video-player{
    transform:rotate(-90deg);
    width:100%;height:100%;
  }

  /* 全屏状态 */
  .video-wrapper.is-fullscreen{
    position:fixed!important;top:0!important;left:0!important;width:100vw!important;height:100vh!important;
    max-width:100vw!important;max-height:100vh!important;aspect-ratio:auto!important;
    z-index:9999;border:none;border-radius:0;background:#000;overflow:hidden;
  }
  .video-wrapper.is-fullscreen .video-player{width:100%;height:100%;object-fit:contain;}
  .video-wrapper.is-fullscreen .fs-btn{bottom:16px;right:16px;width:44px;height:44px;font-size:20px;}
  .video-wrapper.is-fullscreen .fs-btn.exit{display:flex;}

  /* 页脚 */
  footer{text-align:center;padding:20px 16px;color:var(--ink-light);font-size:11px;border-top:1px solid var(--border);margin-top:20px;}
  footer .orn{margin:6px 0;letter-spacing:6px;color:var(--vermilion);opacity:0.5;}

  @media (min-width:600px){.cat-grid{grid-template-columns:repeat(4,1fr);}}
  @media (min-width:900px){.cat-grid{grid-template-columns:repeat(5,1fr);}h1{font-size:44px;}}
  ::-webkit-scrollbar{width:6px;}
  ::-webkit-scrollbar-track{background:var(--paper-dark);}
  ::-webkit-scrollbar-thumb{background:var(--border);border-radius:1px;}

  /* === 登录系统 === */
  .login-view{
    position:fixed;top:0;left:0;right:0;bottom:0;z-index:9999;
    background:linear-gradient(180deg,rgba(240,230,210,0.98),rgba(220,200,170,0.98));
    display:flex;align-items:center;justify-content:center;padding:20px;
  }
  .login-view.hidden{display:none;}
  .login-box{
    width:100%;max-width:340px;background:rgba(255,252,240,0.95);
    border:2px solid var(--border);border-radius:3px;padding:28px 22px;
    box-shadow:0 8px 30px rgba(43,29,14,0.2);
  }
  .login-box::before{
    content:'';position:absolute;top:6px;left:6px;right:6px;bottom:6px;
    border:1px solid rgba(122,100,64,0.3);pointer-events:none;
  }
  .login-box h2{
    font-family:'Ma Shan Zheng',cursive;font-size:28px;color:var(--ink);
    text-align:center;margin-bottom:6px;letter-spacing:4px;
  }
  .login-box .login-sub{
    text-align:center;font-size:12px;color:var(--ink-light);margin-bottom:20px;letter-spacing:2px;
  }
  .login-box .login-row{margin-bottom:14px;}
  .login-box label{
    display:block;font-size:12px;color:var(--ink-light);margin-bottom:5px;letter-spacing:1px;
  }
  .login-box input{
    width:100%;padding:10px 12px;font-size:14px;font-family:inherit;
    background:rgba(255,252,240,0.8);border:1px solid var(--border);border-radius:2px;
    color:var(--ink);outline:none;
  }
  .login-box input:focus{border-color:var(--vermilion);box-shadow:0 0 0 2px rgba(168,38,30,0.1);}
  .login-box .login-btn{
    width:100%;padding:11px;margin-top:8px;
    background:linear-gradient(135deg,var(--vermilion),var(--vermilion-deep));
    border:1px solid var(--vermilion-deep);border-radius:2px;
    color:#fff;font-size:15px;font-family:'Ma Shan Zheng',cursive;letter-spacing:4px;cursor:pointer;
    transition:all 0.2s;
  }
  .login-box .login-btn:active{transform:scale(0.98);}
  .login-box .login-error{
    color:var(--vermilion);font-size:12px;text-align:center;margin-top:10px;min-height:18px;
  }
  .login-box .register-link{
    text-align:center;margin-top:14px;font-size:12px;color:var(--ink-light);
  }
  .login-box .register-link a{color:var(--vermilion);cursor:pointer;text-decoration:none;}

  /* 顶部用户栏 */
  .user-bar{
    display:flex;align-items:center;gap:8px;margin-left:auto;
    font-size:12px;color:var(--ink-light);
  }
  .user-bar .user-name{
    font-family:'Ma Shan Zheng',cursive;font-size:14px;color:var(--ink);
  }
  .user-bar .user-role{
    padding:2px 8px;border-radius:1px;font-size:11px;
    background:rgba(168,38,30,0.1);color:var(--vermilion);
  }
  .user-bar .user-role.admin{background:rgba(166,124,0,0.15);color:var(--gold);}
  .user-bar .logout-btn{
    background:none;border:1px solid var(--border);border-radius:2px;
    padding:3px 8px;font-size:11px;color:var(--ink-light);cursor:pointer;
  }
  .user-bar .logout-btn:active{background:var(--vermilion);color:#fff;}

  /* 权限标记 */
  .cat-card.restricted::before{
    content:'';position:absolute;top:3px;left:3px;right:3px;bottom:3px;
    border:1px dashed rgba(168,38,30,0.4);pointer-events:none;
  }
  .cat-card .lock-icon{
    position:absolute;top:6px;left:6px;font-size:10px;opacity:0.6;
  }

  /* 注册表单 */
  .reg-link{
    text-align:center;margin-top:12px;font-size:12px;color:var(--ink-light);
  }
  .reg-link a{color:var(--vermilion);cursor:pointer;}

  /* 解锁栏 */
  .unlock-bar{
    display:flex;gap:8px;padding:8px 12px;margin-bottom:4px;
    background:rgba(168,38,30,0.06);border:1px dashed rgba(168,38,30,0.2);border-radius:3px;
  }
  .unlock-bar input{
    flex:1;padding:8px 10px;font-size:13px;font-family:inherit;
    background:rgba(255,252,240,0.8);border:1px solid var(--border);border-radius:2px;
    color:var(--ink);outline:none;
  }
  .unlock-bar input:focus{border-color:var(--vermilion);}
  .unlock-bar button{
    padding:8px 16px;background:linear-gradient(135deg,var(--vermilion),var(--vermilion-deep));
    border:1px solid var(--vermilion-deep);border-radius:2px;color:#fff;font-size:13px;
    font-family:'Ma Shan Zheng',cursive;letter-spacing:2px;cursor:pointer;white-space:nowrap;
  }
  .unlock-bar button:active{transform:scale(0.96);}

  /* 邀请码面板已移除，改用设置弹窗 */

  /* 设置弹窗（管理员） */
  .settings-modal{
    display:none;position:fixed;top:0;left:0;right:0;bottom:0;z-index:10000;
    background:rgba(0,0,0,0.5);align-items:center;justify-content:center;
  }
  .settings-modal.show{display:flex;}
  .settings-box{
    width:90%;max-width:380px;max-height:80vh;overflow-y:auto;
    background:rgba(255,252,240,0.98);border:2px solid var(--border);border-radius:3px;
    box-shadow:0 8px 30px rgba(43,29,14,0.3);
  }
  .settings-header{
    display:flex;justify-content:space-between;align-items:center;
    padding:14px 16px;border-bottom:1px solid var(--border);
  }
  .settings-header h3{
    font-family:'Ma Shan Zheng',cursive;font-size:18px;color:var(--ink);letter-spacing:2px;
  }
  .settings-close{
    width:30px;height:30px;background:none;border:1px solid var(--border);border-radius:2px;
    font-size:16px;color:var(--ink-light);cursor:pointer;
  }
  .settings-close:active{background:var(--vermilion);color:#fff;}
  .settings-body{padding:12px 16px;}
  .settings-body .code-row{
    display:flex;justify-content:space-between;align-items:center;
    padding:8px 0;border-bottom:1px dotted rgba(122,100,64,0.2);font-size:13px;
  }
  .settings-body .code-row:last-child{border-bottom:none;}
  .settings-body .code-cat{color:var(--ink);}
  .settings-body .code-val{
    font-family:monospace;color:var(--vermilion);font-weight:bold;
    padding:3px 10px;background:rgba(168,38,30,0.08);border-radius:1px;
  }

  /* 管理员设置按钮 */
  .settings-btn{
    width:32px;height:32px;background:none;border:1px solid var(--border);border-radius:2px;
    font-size:16px;color:var(--ink-light);cursor:pointer;display:flex;align-items:center;justify-content:center;
  }
  .settings-btn:active{background:var(--vermilion);color:#fff;}

/* ===== 下载按钮样式 ===== */
.download-bar{display:flex;gap:10px;justify-content:center;margin:12px 0;flex-wrap:wrap;}
.dl-btn{background:linear-gradient(135deg,#8B4513,#A0522D);color:#fff;border:none;padding:10px 20px;border-radius:4px;font-size:14px;cursor:pointer;letter-spacing:1px;transition:all 0.3s;font-family:inherit;}
.dl-btn:hover{background:linear-gradient(135deg,#A0522D,#CD853F);transform:translateY(-1px);box-shadow:0 2px 8px rgba(0,0,0,0.2);}
.dl-btn:disabled{background:#999;cursor:not-allowed;transform:none;box-shadow:none;}
.dl-btn.primary{background:linear-gradient(135deg,#B8860B,#DAA520);}
.dl-btn.danger{background:linear-gradient(135deg,#8B0000,#B22222);}
.dl-count{font-size:13px;color:var(--ink-light);text-align:center;margin:4px 0;}

/* 目录页多选 */
.cat-item.selectable{cursor:pointer;}
.cat-item .cat-checkbox{display:none;width:18px;height:18px;margin-right:8px;accent-color:#8B4513;cursor:pointer;}
.cat-item.selectable .cat-checkbox{display:inline-block;}
.select-bar{display:flex;align-items:center;gap:12px;padding:10px 14px;background:var(--card);border-radius:4px;margin:8px 0;border:1px solid var(--border);}
.select-bar label{font-size:13px;cursor:pointer;display:flex;align-items:center;gap:6px;}
.select-bar input[type=checkbox]{accent-color:#8B4513;width:16px;height:16px;}
.select-bar .selected-info{font-size:13px;color:var(--ink-light);flex:1;text-align:right;}

/* 下载弹窗 */
.dl-modal-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:1000;display:flex;align-items:center;justify-content:center;}
.dl-modal{background:var(--bg);border:2px solid var(--border);border-radius:6px;padding:24px;max-width:420px;width:90%;box-shadow:0 8px 32px rgba(0,0,0,0.3);}
.dl-modal h3{margin:0 0 12px 0;font-size:18px;color:var(--ink);}
.dl-modal .dl-options{display:flex;flex-direction:column;gap:10px;margin-bottom:16px;}
.dl-modal .dl-options label{display:flex;align-items:center;gap:8px;font-size:14px;cursor:pointer;}
.dl-modal .dl-options input[type=checkbox]{accent-color:#8B4513;width:16px;height:16px;}
.dl-modal textarea{width:100%;min-height:120px;border:1px solid var(--border);border-radius:4px;padding:8px;font-family:inherit;font-size:13px;resize:vertical;background:var(--card);color:var(--ink);}
.dl-modal .dl-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:16px;}

/* 权限提示 */
.dl-permission-warn{background:var(--warn-bg,rgba(255,200,100,0.1));border:1px solid var(--warn-color,#DAA520);border-radius:4px;padding:8px 12px;margin:8px 0;font-size:13px;color:var(--ink);}

</style>
</head>
<body>

<!-- ========== 登录页面 ========== -->
<div class="login-view" id="loginView">
  <div class="login-box">
    <h2>吟诵学堂</h2>
    <div class="login-sub">邀 请 码 进 入</div>
    <div class="login-row">
      <label>请输入邀请码</label>
      <input type="text" id="inviteCode" placeholder="输入邀请码" autocomplete="off">
    </div>
    <button class="login-btn" onclick="doLogin()">进 入</button>
    <div class="login-error" id="loginError"></div>
  </div>
</div>

<!-- ========== 管理员设置弹窗 ========== -->
<div class="settings-modal" id="settingsModal">
  <div class="settings-box">
    <div class="settings-header">
      <h3>📋 邀请码管理</h3>
      <button class="settings-close" onclick="closeSettings()">✕</button>
    </div>
    <div class="settings-body" id="settingsBody"></div>
  </div>
</div>

<div class="container">

<!-- ========== 一级：首页 ========== -->
<div class="view active" id="view-home">
  <div class="home-header">
    <div class="user-bar" id="homeUserBar" style="margin-bottom:6px;"></div>
    <h1>吟诵学堂</h1>
    <div class="sub">古 诗 文 吟 诵 · 示 范 微 课</div>
    <div class="seal">珍藏典藏</div>
  </div>
  <!-- 普通用户：解锁栏 -->
  <div class="unlock-bar" id="unlockBar" style="display:none;">
    <input type="text" id="unlockInput" placeholder="输入邀请码，解锁更多分类" autocomplete="off">
    <button onclick="doUnlock()">解锁</button>
  </div>
  <div class="search-wrap">
    <input type="text" id="homeSearch" placeholder="🔍 搜索诗词名、分类、年级...">
  </div>
  <div class="sr-list" id="homeResults" style="display:none;"></div>
  <div class="cat-grid" id="catGrid"></div>
  <div id="gridFooter" style="display:none;text-align:center;padding:14px 10px;color:var(--ink-light);font-size:12px;"></div>
</div>

<!-- ========== 二级：目录列表 ========== -->
<div class="view" id="view-catalog">
  <div class="topbar">
    <button class="back" onclick="goHome()">← 首页</button>
    <div class="title" id="catTitle"></div>
    <div class="count" id="catCount"></div>
    <div class="user-bar" id="catalogUserBar"></div>
  </div>
  <div class="search-wrap">
    <input type="text" id="catSearch" placeholder="🔍 在此页搜索诗词名...">
  </div>
  <div class="select-bar" id="selectBar" style="display:none;">
    <label><input type="checkbox" id="selectAll" onchange="toggleSelectAll(this.checked)"> 全选本页</label>
    <span class="selected-info" id="selectedInfo">已选 0 首</span>
    <button class="dl-btn primary" onclick="batchDownload()">⬇ 批量下载</button>
    <button class="dl-btn" onclick="clearSelection()">清空选择</button>
  </div>
  <div class="catalog" id="catalogList"></div>
  <div class="pagination" id="catPagination"></div>
</div>

<!-- ========== 三级：诗词详情 ========== -->
<div class="view" id="view-detail">
  <div class="topbar">
    <button class="back" onclick="backToCatalog()">← 返回</button>
    <div class="title" id="detailTitle"></div>
    <div class="count" id="detailMeta"></div>
  </div>
  <div id="detailContent"></div>
  <div class="download-bar" id="detailDownloadBar" style="display:none;"></div>
</div>

<footer>
  <div class="orn">❦ ❦ ❦</div>
  吟诵学堂 · 古诗文吟诵与示范微课典藏
  <div style="margin-top:4px;">共 414 首 · 音频 895 条 · 微课 130 条</div>
</footer>

</div>

<audio id="audioPlayer"></audio>

