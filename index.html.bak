  'yu123': {role:'admin', name:'管理员'},
  'admin': {role:'user',  name:'普通用户'}
};
// 每个分类对应的邀请码（普通用户输入解锁）
const CATEGORY_CODES = {
  '一年级': 'YG2024A',
  '二年级': 'EG2024B',
  '三年级': 'SG2024C',
  '四年级': 'SG2024D',
  '五年级': 'WG2024E',
  '六年级': 'LG2024F',
  '七年级': 'QG2024G',
  '八年级': 'BG2024H',
  '九年级': 'JG2024I',
  '文言文选择性必修（10篇）': 'WX2024J',
  '高中文言文必修（10篇）': 'GX2024K',
  '高中文言文选修（12篇）': 'GX2024L',
  '高中诗词曲（40首）': 'GS2024M'
};

let unlockedCats = [];
let currentUser = null;
const CACHE_VERSION = 'v3';

function initUserSystem(){
  const saved = localStorage.getItem('yss_user_state');
  if (saved) {
    try {
      const state = JSON.parse(saved);
      if (state.version !== CACHE_VERSION) {
        localStorage.removeItem('yss_user_state');
      } else {
        currentUser = state.currentUser;
        unlockedCats = state.unlockedCats || [];
      }
    } catch(e) { localStorage.removeItem('yss_user_state'); }
  }
  if (currentUser) {
    hideLoginView();
    updateUserBar();
    updateUnlockBar();
    renderCatGrid();
  } else {
    showLoginView();
  }
}

function saveState(){
  localStorage.setItem('yss_user_state', JSON.stringify({currentUser, unlockedCats, version: CACHE_VERSION}));
}

function showLoginView(){
  document.getElementById('loginView').classList.remove('hidden');
  const inp = document.getElementById('inviteCode');
  if (inp) inp.value = '';
  const err = document.getElementById('loginError');
  if (err) err.textContent = '';
}
function hideLoginView(){
  document.getElementById('loginView').classList.add('hidden');
}

// 首次登录
function doLogin(){
  const raw = document.getElementById('inviteCode').value;
  const code = raw.replace(/\s/g, '').toLowerCase();
  const errEl = document.getElementById('loginError');
  if (!code) {
    errEl.textContent = '请输入邀请码';
    return;
  }
  // 检查登录码
  let foundUser = null;
  for (const [k, v] of Object.entries(LOGIN_CODES)) {
    if (k.toLowerCase() === code) {foundUser = v; break;}
  }
  if (foundUser) {
    currentUser = foundUser;
    if (currentUser.role === 'admin') unlockedCats = Object.keys(CATEGORY_CODES);
    saveState();
    hideLoginView();
    updateUserBar();
    updateUnlockBar();
    renderCatGrid();
    return;
  }
  // 检查分类码（直接用分类码登录=解锁该分类）
  const upperCode = raw.replace(/\s/g, '').toUpperCase();
  let foundCat = null;
  for (const [cat, c] of Object.entries(CATEGORY_CODES)) {
    if (c.toUpperCase() === upperCode) {foundCat = cat; break;}
  }
  if (foundCat) {
    currentUser = LOGIN_CODES['admin'];
    if (!unlockedCats.includes(foundCat)) unlockedCats.push(foundCat);
    saveState();
    hideLoginView();
    updateUserBar();
    updateUnlockBar();
    renderCatGrid();
    return;
  }
  errEl.textContent = '邀请码无效';
}

// 首页解锁更多分类（普通用户）
function doUnlock(){
  const raw = document.getElementById('unlockInput').value;
  const inp = document.getElementById('unlockInput');
  if (!raw.trim()) return;
  const upperCode = raw.replace(/\s/g, '').toUpperCase();
  let foundCat = null;
  for (const [cat, c] of Object.entries(CATEGORY_CODES)) {
    if (c.toUpperCase() === upperCode) {foundCat = cat; break;}
  }
  if (foundCat) {
    if (unlockedCats.includes(foundCat)) {
      alert('该分类已解锁：' + foundCat);
    } else {
      unlockedCats.push(foundCat);
      saveState();
      renderCatGrid();
      alert('已解锁：' + foundCat);
    }
    inp.value = '';
    return;
  }
  alert('邀请码无效');
  inp.value = '';
}

function doLogout(){
  currentUser = null;
  unlockedCats = [];
  localStorage.removeItem('yss_user_state');
  showLoginView();
}

function updateUserBar(){
  if (!currentUser) return;
  const adminBadge = currentUser.role === 'admin' 
    ? '<span class="user-role admin">管理员</span>' 
    : '<span class="user-role">普通用户</span>';
  const settingsBtn = currentUser.role === 'admin' 
    ? '<button class="settings-btn" onclick="openSettings()">⚙</button>' 
    : '';
  const bar = `<span class="user-name">${currentUser.name}</span>${adminBadge}${settingsBtn}<button class="logout-btn" onclick="doLogout()">退出</button>`;
  const homeBar = document.getElementById('homeUserBar');
  if (homeBar) homeBar.innerHTML = bar;
  const catBar = document.getElementById('catalogUserBar');
  if (catBar) catBar.innerHTML = bar;
}

function updateUnlockBar(){
  const bar = document.getElementById('unlockBar');
  if (bar) bar.style.display = (currentUser && currentUser.role === 'user') ? 'flex' : 'none';
}

// 管理员设置弹窗
function openSettings(){
  const body = document.getElementById('settingsBody');
  let html = '';
  for (const [cat, code] of Object.entries(CATEGORY_CODES)) {
    html += `<div class="code-row"><span class="code-cat">${cat}</span><span class="code-val">${code}</span></div>`;
  }
  html += '<div style="margin-top:12px;padding-top:8px;border-top:1px solid var(--border);font-size:12px;color:var(--ink-light);">管理员码：yu123 / 普通用户码：admin</div>';
  body.innerHTML = html;
  document.getElementById('settingsModal').classList.add('show');
}
function closeSettings(){
  document.getElementById('settingsModal').classList.remove('show');
}

function hasPermission(cat){
  if (!currentUser) return false;
  if (currentUser.role === 'admin') return true;
  return unlockedCats.includes(cat);
}

/* ===== 初始化 ===== */
initUserSystem();
renderCatGrid();
</script>
</body>
</html>