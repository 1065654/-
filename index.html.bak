const AUDIO_ICONS = {'读诵':'📖','乐吟':'🎵','伴奏':'🎹','基础清吟':'🎻','度曲清吟':'🎻','传统吟咏':'🎶'};
function getAudioIcon(name){ return AUDIO_ICONS[name] || '🔊'; }

const player = document.getElementById('audioPlayer');
let currentPlaying = null;
let lastCatalog = {cat:'', page:0, pageSize:20, query:''};

/* ===== 音频播放 ===== */
let currentAudioUrl = '';
function playAudio(el, url){
  // 如果点击的是当前播放的按钮，切换暂停/继续
  if (currentPlaying && currentPlaying === el) {
    if (player.paused) {
      player.play();
      el.classList.add('playing');
      el.querySelector('.btn-state').textContent = '⏸';
    } else {
      player.pause();
      el.classList.remove('playing');
      el.querySelector('.btn-state').textContent = '▶';
    }
    return;
  }
  // 断掉之前的音频
  if (currentPlaying) {
    currentPlaying.classList.remove('playing');
    const prevState = currentPlaying.querySelector('.btn-state');
    if (prevState) prevState.textContent = '▶';
  }
  // 断掉所有视频
  document.querySelectorAll('.video-player').forEach(v => {if (!v.paused) v.pause();});
  // 播放新音频
  player.pause();
  player.src = url;
  player.play();
  el.classList.add('playing');
  el.querySelector('.btn-state').textContent = '⏸';
  currentPlaying = el;
  currentAudioUrl = url;
}
player.addEventListener('ended', () => {
  if (currentPlaying) {
    currentPlaying.classList.remove('playing');
    const state = currentPlaying.querySelector('.btn-state');
    if (state) state.textContent = '▶';
    currentPlaying = null;
    currentAudioUrl = '';
  }
});
player.addEventListener('play', () => {
  document.querySelectorAll('.video-player').forEach(v => {if (!v.paused) v.pause();});
});

/* ===== 视频控制 ===== */
function initVideoPlayers(){
  document.querySelectorAll('.video-player').forEach(video => {
    const wrapper = video.closest('.video-wrapper');
    const overlay = wrapper ? wrapper.querySelector('.video-overlay') : null;
    video.addEventListener('play', () => {
      // 断掉所有音频
      player.pause();
      if (currentPlaying) {
        currentPlaying.classList.remove('playing');
        const state = currentPlaying.querySelector('.btn-state');
        if (state) state.textContent = '▶';
        currentPlaying = null;
      }
      // 断掉其他视频
      document.querySelectorAll('.video-player').forEach(v => {if (v !== video && !v.paused) v.pause();});
      if (wrapper) wrapper.classList.add('playing');
    });
    video.addEventListener('pause', () => {if (wrapper) wrapper.classList.remove('playing');});
    if (overlay) overlay.addEventListener('click', () => video.play());
  });
}

/* ===== 视图切换 ===== */
function showView(id){
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  window.scrollTo(0, 0);
}

/* ===== 首页：渲染分类网格 ===== */
function renderCatGrid(){
  const grid = document.getElementById('catGrid');
  const visible = catInfo.filter(c => hasPermission(c.cat));
  if (visible.length === 0) {
    grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:30px;color:var(--ink-light);font-size:13px;">请输入邀请码解锁分类</div>';
    return;
  }
  grid.innerHTML = visible.map(c => {
    const cls = c.hasVideo ? 'cat-card has-video' : 'cat-card';
    return `<div class="${cls}" onclick="openCatalog('${c.cat}', 0)">
      <div class="cn">${c.cat}</div>
      <div class="cc"><span class="num">${c.count}</span> 首</div>
    </div>`;
  }).join('');
}

/* ===== 首页：搜索 ===== */
document.getElementById('homeSearch').addEventListener('input', function(){
  const q = this.value.trim().toLowerCase();
  const results = document.getElementById('homeResults');
  const grid = document.getElementById('catGrid');
  const footer = document.getElementById('gridFooter');
  if (!q) {results.style.display='none';results.innerHTML='';grid.style.display='';footer.style.display='none';return;}
  grid.style.display='none';
  const all = [];
  for (const cat in poemData) {if(!hasPermission(cat)) continue;for (const p of poemData[cat]) {all.push({...p, cat});}}
  const matched = all.filter(p => p.poem.toLowerCase().includes(q) || p.cat.toLowerCase().includes(q));
  results.style.display='flex';
  if (matched.length === 0) {results.innerHTML='<div class="no-data">没有找到匹配的诗词</div>';footer.style.display='none';return;}
  results.innerHTML = matched.slice(0,50).map(p => {
    const v = p.videos.length>0 ? ' 🎬' : '';
    const shortC = p.cat.replace(/（/g,'(').replace(/）/g,')');
    return `<div class="sr-item" onclick="openDetail('${p.cat}','${p.poem.replace(/'/g,"\\'")}')">
      <span class="sr-name">${p.poem}${v}</span><span class="sr-cat">${shortC}</span></div>`;
  }).join('');
  if (matched.length > 50) {footer.style.display='block';footer.textContent=`共 ${matched.length} 条，仅显示前50条`;}
  else {footer.style.display='none';}
});

/* ===== 打开目录页（二级） ===== */
function openCatalog(cat, page){
  if(cat !== '__all__' && !hasPermission(cat)){alert('请先解锁该分类');return;}
  lastCatalog = {cat, page, pageSize:20, query:''};
  document.getElementById('catSearch').value = '';
  const poems = getCatalogPoems(cat);
  document.getElementById('catTitle').textContent = cat === '__all__' ? '全部诗词' : cat;
  document.getElementById('catCount').textContent = poems.length + ' 首';
  renderCatalogList();
  showView('view-catalog');
}

function getCatalogPoems(cat){
  if (cat === '__all__') {
    const all = [];
    for (const c in poemData) {if(!hasPermission(c)) continue;for (const p of poemData[c]) {all.push({...p, cat:c});}}
    return all;
  }
  return (poemData[cat] || []).map(p => ({...p, cat}));
}

function renderCatalogList(){
  // 更新选择栏
  if (lastCatalog.cat !== '__all__' && lastCatalog.cat !== '') {
    const canSelect = typeof hasPermission === 'function' ? hasPermission(lastCatalog.cat) : true;
    const bar = document.getElementById('selectBar');
    if (bar) {
      if (canSelect) {
        bar.style.display = 'flex';
        const count = Object.keys(window.__selectedItems || {}).length;
        document.getElementById('selectedInfo').textContent = `已选 ${count} 首`;
      } else {
        bar.style.display = 'none';
      }
    }
  } else {
    const bar = document.getElementById('selectBar');
    if (bar) bar.style.display = 'none';
  }
  
  const poems = getCatalogPoems(lastCatalog.cat);
  const q = lastCatalog.query.toLowerCase();
  const filtered = q ? poems.filter(p => p.poem.toLowerCase().includes(q)) : poems;
  const total = filtered.length;
  const pages = Math.max(1, Math.ceil(total / lastCatalog.pageSize));
  if (lastCatalog.page >= pages) lastCatalog.page = 0;
  const start = lastCatalog.page * lastCatalog.pageSize;
  const pageItems = filtered.slice(start, start + lastCatalog.pageSize);

  const list = document.getElementById('catalogList');
  if (pageItems.length === 0) {
    list.innerHTML = '<div class="no-data">没有找到匹配的诗词</div>';
  } else {
    list.innerHTML = pageItems.map(p => {
      const v = p.videos.length>0 ? '<span class="ci-video">🎬</span>' : '';
      const shortC = p.cat ? p.cat.replace(/（/g,'(').replace(/）/g,')') : '';
      const catTag = lastCatalog.cat === '__all__' ? `<span class="ci-name" style="font-size:14px;">${p.poem}</span>` : `<span class="ci-name">${p.poem}</span>`;
      return `<div class="cat-item" onclick="openDetail('${p.cat}','${p.poem.replace(/'/g,"\\'")}')">
        ${lastCatalog.cat === '__all__' ? `<div style="display:flex;flex-direction:column;gap:2px;"><span class="ci-name">${p.poem}</span><span style="font-size:11px;color:var(--ink-light);">${shortC}</span></div>` : `<span class="ci-name">${p.poem}</span>`}
        <div class="ci-meta">${v}<span class="ci-arrow">›</span></div>
      </div>`;
    }).join('');
  }

  // 分页
  const pg = document.getElementById('catPagination');
  if (pages <= 1) {
    pg.innerHTML = `<span class="pg-info">共 ${total} 首</span>`;
  } else {
    pg.innerHTML = `
      <button onclick="changePage(${lastCatalog.page - 1})" ${lastCatalog.page === 0 ? 'disabled' : ''}>← 上一页</button>
      <span class="pg-info">第 ${lastCatalog.page + 1}/${pages} 页 · ${total} 首</span>
      <button onclick="changePage(${lastCatalog.page + 1})" ${lastCatalog.page >= pages - 1 ? 'disabled' : ''}>下一页 →</button>
    `;
  }
}

function changePage(p){
  lastCatalog.page = p;
  renderCatalogList();
  window.scrollTo(0, 0);
}

/* ===== 目录页搜索 ===== */
document.getElementById('catSearch').addEventListener('input', function(){
  lastCatalog.query = this.value.trim();
  lastCatalog.page = 0;
  renderCatalogList();
});

/* ===== 打开详情页（三级） ===== */
function openDetail(cat, poemName){
  if(!hasPermission(cat)){alert('请先解锁该分类');return;}
  const poem = (poemData[cat] || []).find(p => p.poem === poemName);
  if (!poem) return;
  const shortC = cat.replace(/（/g,'(').replace(/）/g,')');
  document.getElementById('detailTitle').textContent = poemName;
  document.getElementById('detailMeta').textContent = shortC;

  const audioHtml = poem.audios.length > 0 ? `
    <div class="audio-group">
      <div class="ag-label">🎧 吟诵音频</div>
      <div class="audio-btns">
        ${poem.audios.map(a => `<div class="audio-btn" onclick="playAudio(this,'${a.url}')"><span>${getAudioIcon(a.name)}</span><span>${a.name}</span><span class="btn-state">▶</span></div>`).join('')}
      </div>
    </div>` : '';

  const videoHtml = poem.videos.length > 0 ? `
    <div class="video-collapse">
      <div class="video-header" onclick="toggleVideo(this)">
        <div class="vh-title">🎬 示范微课</div>
        <div class="vh-arrow">▶</div>
      </div>
      <div class="video-body">
        <div class="video-inner">
          <div class="video-wrapper">
            <video class="video-player" controls preload="none" playsinline webkit-playsinline x5-playsinline x5-video-player-type="h5" x5-video-player-fullscreen="false">
              <source src="${poem.videos[0].url}" type="video/mp4">
            </video>
            <div class="video-overlay">▶</div>
            <div class="ls-btn" onclick="toggleLandscape(this)" title="横屏播放">⇋</div>
            <div class="fs-btn" onclick="toggleFullscreen(this)" title="全屏">⛶</div>
          </div>
        </div>
      </div>
    </div>` : '';

  // 诗词正文、作者、朝代信息
  const poemAuthor = poem.author || '';
  const poemDynasty = poem.dynasty || '';
  const poemContent = poem.content || '';
  const metaHtml = (poemDynasty || poemAuthor) ? `
    <div class="poem-meta" style="text-align:center; font-size:14px; color:var(--ink-light); margin-bottom:16px; letter-spacing:1px;">
      ${poemDynasty ? `<span class="pm-dy">${poemDynasty}</span>` : ''}${poemDynasty && poemAuthor ? '<span style="margin:0 6px;opacity:0.3;">·</span>' : ''}${poemAuthor ? `<span class="pm-au">${poemAuthor}</span>` : ''}
    </div>` : '';
  const contentHtml = poemContent ? `
    <div class="poem-content" style="font-family:'Ma Shan Zheng',cursive; font-size:20px; line-height:2.4; text-align:center; padding:20px 14px; letter-spacing:2px; color:var(--ink); border-top:1px dashed var(--border); border-bottom:1px dashed var(--border); margin-bottom:16px; background:rgba(255,252,240,0.4); border-radius:1px;">
      ${poemContent.split(/\r?\n/).map(line => line.trim() ? `<div style="margin:4px 0;">${line}</div>` : '').join('')}
    </div>` : '';

  document.getElementById('detailContent').innerHTML = `
    <div class="poem-detail">
      <h2>${poemName}</h2>
      <div class="meta-row">${shortC}${poem.audios.length ? ' ·  '+poem.audios.length+'条音频' : ''}${poem.videos.length ? ' ·  '+poem.videos.length+'个微课' : ''}</div>
      ${metaHtml}
      ${contentHtml}
      ${audioHtml}
      ${videoHtml}
      ${(!poem.audios.length && !poem.videos.length && !poemContent) ? '<div class="no-data">暂无资源</div>' : ''}
    </div>
  `;
  initVideoPlayers();
  showView('view-detail');
  renderDetailDownloadBar('${cat}', '${poemName.replace(/'/g, "\'")}');
}


/* ===== 下载功能 ===== */
window.__selectedItems = {};

function renderDetailDownloadBar(cat, poemName){
  const bar = document.getElementById('detailDownloadBar');
  if (!bar) return;
  const poem = (poemData[cat] || []).find(p => p.poem === poemName);
  if (!poem) { bar.style.display = 'none'; return; }
  
  const hasPermission = typeof hasPermission === 'function' ? hasPermission(cat) : true;
  
  let permissionWarn = '';
  if (!hasPermission) {
    permissionWarn = '<div class="dl-permission-warn">⚠️ 您尚未解锁此分类，下载内容可能不完整</div>';
  }
  
  bar.innerHTML = `
    ${permissionWarn}
    <div class="download-bar">
      <button class="dl-btn primary" onclick="downloadSingle('${cat}', '${poemName.replace(/'/g, "\'")}', 'txt')">📄 下载为 TXT</button>
      <button class="dl-btn" onclick="downloadSingle('${cat}', '${poemName.replace(/'/g, "\'")}', 'md')">📝 下载为 Markdown</button>
      <button class="dl-btn" onclick="downloadSingle('${cat}', '${poemName.replace(/'/g, "\'")}', 'json')">💾 下载为 JSON</button>
    </div>
  `;
  bar.style.display = 'block';
}

function toggleSelectItem(cat, poemName, checked){
  const key = cat + '::' + poemName;
  if (!window.__selectedItems) window.__selectedItems = {};
  if (checked) {
    window.__selectedItems[key] = {cat, poemName};
  } else {
    delete window.__selectedItems[key];
  }
  updateSelectBar();
}

function toggleSelectAll(checked){
  const poems = getCatalogPoems(lastCatalog.cat);
  const q = lastCatalog.query.toLowerCase();
  const filtered = q ? poems.filter(p => p.poem.toLowerCase().includes(q)) : poems;
  const start = lastCatalog.page * lastCatalog.pageSize;
  const pageItems = filtered.slice(start, start + lastCatalog.pageSize);
  
  if (!window.__selectedItems) window.__selectedItems = {};
  
  // 检查权限：普通用户只能选择有权限的分类
  const canSelect = lastCatalog.cat === '__all__' ? true : (typeof hasPermission === 'function' ? hasPermission(lastCatalog.cat) : true);
  
  pageItems.forEach(p => {
    const key = p.cat + '::' + p.poem;
    if (checked) {
      if (canSelect || (typeof hasPermission === 'function' && hasPermission(p.cat))) {
        window.__selectedItems[key] = {cat: p.cat, poemName: p.poem};
      }
    } else {
      delete window.__selectedItems[key];
    }
  });
  renderCatalogList();
}

function updateSelectBar(){
  const bar = document.getElementById('selectBar');
  if (!bar) return;
  if (lastCatalog.cat === '__all__' || lastCatalog.cat === '') {
    bar.style.display = 'none';
    return;
  }
  const canSelect = typeof hasPermission === 'function' ? hasPermission(lastCatalog.cat) : true;
  if (!canSelect) {
    bar.style.display = 'none';
    return;
  }
  bar.style.display = 'flex';
  const count = Object.keys(window.__selectedItems || {}).length;
  document.getElementById('selectedInfo').textContent = `已选 ${count} 首`;
}

function clearSelection(){
  window.__selectedItems = {};
  renderCatalogList();
}

function batchDownload(){
  const selected = Object.values(window.__selectedItems || {});
  if (selected.length === 0) {
    alert('请先选择要下载的诗词');
    return;
  }
  
  // 权限检查：过滤掉无权限的
  const authorized = selected.filter(s => typeof hasPermission !== 'function' || hasPermission(s.cat));
  const blocked = selected.length - authorized.length;
  
  if (authorized.length === 0) {
    alert('您没有权限下载所选内容，请先解锁对应分类');
    return;
  }
  
  if (blocked > 0) {
    if (!confirm(`您选择了 ${selected.length} 首诗，其中 ${blocked} 首无权限访问。
是否仅下载有权限的 ${authorized.length} 首？`)) {
      return;
    }
  }
  
  showDownloadModal(authorized);
}

function downloadSingle(cat, poemName, format){
  // 权限检查
  if (typeof hasPermission === 'function' && !hasPermission(cat)) {
    alert('您没有权限下载此内容，请先解锁对应分类');
    return;
  }
  showDownloadModal([{cat, poemName}], format);
}

function showDownloadModal(items, defaultFormat){
  const format = defaultFormat || 'txt';
  const isMulti = items.length > 1;
  
  // 生成下载内容预览
  const contents = items.map(item => {
    const poem = (poemData[item.cat] || []).find(p => p.poem === item.poemName);
    if (!poem) return null;
    
    let text = '';
    text += `《${poem.poem}》
`;
    if (poem.dynasty || poem.author) {
      text += `${poem.dynasty || ''}${poem.author ? '·' + poem.author : ''}
`;
    }
    if (poem.content) {
      text += '
' + poem.content + '
';
    }
    return {name: poem.poem, content: text, poem: poem};
  }).filter(Boolean);
  
  if (contents.length === 0) {
    alert('没有可下载的内容');
    return;
  }
  
  // 创建弹窗
  const overlay = document.createElement('div');
  overlay.className = 'dl-modal-overlay';
  overlay.innerHTML = `
    <div class="dl-modal" onclick="event.stopPropagation()">
      <h3>${isMulti ? `批量下载（${contents.length}首）` : '下载此诗'}</h3>
      <div class="dl-options">
        <label>下载格式：
          <select id="dlFormat" style="padding:4px 8px;border-radius:4px;border:1px solid var(--border);background:var(--card);color:var(--ink);font-family:inherit;">
            <option value="txt" ${format==='txt'?'selected':''}>TXT 纯文本</option>
            <option value="md" ${format==='md'?'selected':''}>Markdown</option>
            <option value="json" ${format==='json'?'selected':''}>JSON 数据</option>
          </select>
        </label>
      </div>
      <div style="font-size:13px;color:var(--ink-light);margin-bottom:8px;">下载预览：</div>
      <textarea id="dlPreview" readonly></textarea>
      <div class="dl-actions">
        <button class="dl-btn" onclick="this.closest('.dl-modal-overlay').remove()">取消</button>
        <button class="dl-btn primary" id="confirmDownload">⬇ 确认下载</button>
      </div>
    </div>
  `;
  document.body.appendChild(overlay);
  
  // 更新预览
  function updatePreview(){
    const fmt = document.getElementById('dlFormat').value;
    let preview = '';
    for (const c of contents) {
      if (fmt === 'json') {
        const data = {
          poem: c.poem.poem,
          author: c.poem.author || '',
          dynasty: c.poem.dynasty || '',
          content: c.poem.content || ''
        };
        preview += JSON.stringify(data, null, 2) + ',\n';
      } else if (fmt === 'md') {
        preview += `# ${c.poem.poem}\n`;
        if (c.poem.dynasty || c.poem.author) {
          preview += `> ${c.poem.dynasty || ''}${c.poem.author ? '·' + c.poem.author : ''}\n\n`;
        }
        if (c.poem.content) {
          preview += c.poem.content.replace(/\n/g, '  \n') + '\n';
        }
        preview += '---\n\n';
      } else {
        preview += c.content + '\n';
      }
    }
    if (fmt === 'json') preview = '[' + preview.slice(0, -2) + ']';
    document.getElementById('dlPreview').value = preview;
  }
  
  updatePreview();
  document.getElementById('dlFormat').addEventListener('change', updatePreview);
  
  document.getElementById('confirmDownload').onclick = function(){
    const fmt = document.getElementById('dlFormat').value;
    const text = document.getElementById('dlPreview').value;
    const firstPoem = contents[0].poem;
    
    let mime = 'text/plain;charset=utf-8';
    let ext = '.txt';
    if (fmt === 'json') { mime = 'application/json;charset=utf-8'; ext = '.json'; }
    else if (fmt === 'md') { mime = 'text/markdown;charset=utf-8'; ext = '.md'; }
    
    const blob = new Blob([text], {type: mime});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = isMulti ? `古诗文合集_${contents.length}首${ext}` : `${firstPoem.poem}${ext}`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    overlay.remove();
  };
  
  overlay.onclick = function() { overlay.remove(); };
}

function toggleVideo(header){
  const collapse = header.closest('.video-collapse');
  collapse.classList.toggle('open');
  const body = collapse.querySelector('.video-body');
  const isOpen = collapse.classList.contains('open');
  body.style.maxHeight = isOpen ? '500px' : '0';
  const arrow = header.querySelector('.vh-arrow');
  if (arrow) arrow.textContent = isOpen ? '▼' : '▶';
}

/* ===== 全屏切换 ===== */
function toggleFullscreen(btn){
  const wrapper = btn.closest('.video-wrapper');
  const isFull = wrapper.classList.contains('is-fullscreen');
  if (isFull) {
    // 退出全屏
    wrapper.classList.remove('is-fullscreen');
    btn.textContent = '⛶';btn.classList.remove('exit');btn.title = '全屏';
  } else {
    // 退出横屏（如果在横屏中）
    if (wrapper.classList.contains('is-landscape')) {
      wrapper.classList.remove('is-landscape');
      const lsBtn = wrapper.querySelector('.ls-btn');
      if (lsBtn) {lsBtn.textContent='⇋';lsBtn.classList.remove('active');lsBtn.title='横屏播放';}
    }
    // 进入全屏
    wrapper.classList.add('is-fullscreen');
    btn.textContent = '✕';btn.classList.add('exit');btn.title = '退出全屏';
  }
}

/* 点击全屏/横屏区域外退出 */
document.addEventListener('click', function(e){
  if (e.target.classList && e.target.classList.contains('is-fullscreen')) {
    e.target.classList.remove('is-fullscreen');
    const btn = e.target.querySelector('.fs-btn');
    if (btn) {btn.textContent='⛶';btn.classList.remove('exit');btn.title='全屏';}
  }
  if (e.target.classList && e.target.classList.contains('is-landscape')) {
    e.target.classList.remove('is-landscape');
    const btn = e.target.querySelector('.ls-btn');
    if (btn) {btn.textContent='⇋';btn.classList.remove('active');btn.title='横屏播放';}
  }
});

/* ESC键退出全屏和横屏 */
document.addEventListener('keydown', function(e){
  if (e.key === 'Escape') {
    // 退出全屏
    document.querySelectorAll('.video-wrapper.is-fullscreen').forEach(w => {
      w.classList.remove('is-fullscreen');
      const btn = w.querySelector('.fs-btn');
      if (btn) {btn.textContent='⛶';btn.classList.remove('exit');btn.title='全屏';}
    });
    // 退出横屏
    document.querySelectorAll('.video-wrapper.is-landscape').forEach(w => {
      w.classList.remove('is-landscape');
      const btn = w.querySelector('.ls-btn');
      if (btn) {btn.textContent='⇋';btn.classList.remove('active');btn.title='横屏播放';}
    });
  }
});

/* ===== 横屏切换 ===== */
function toggleLandscape(btn){
  const wrapper = btn.closest('.video-wrapper');
  const isLandscape = wrapper.classList.contains('is-landscape');
  if (isLandscape) {
    // 退出横屏
    wrapper.classList.remove('is-landscape');
    btn.textContent = '⇋';btn.classList.remove('active');btn.title = '横屏播放';
    // 恢复视频播放器控件方向
    const video = wrapper.querySelector('.video-player');
    if (video) {video.style.transform = '';}
    const overlay = wrapper.querySelector('.video-overlay');
    if (overlay) {overlay.style.transform = '';}
  } else {
    // 退出全屏（如果在全屏中）
    if (wrapper.classList.contains('is-fullscreen')) {
      wrapper.classList.remove('is-fullscreen');
      const fsBtn = wrapper.querySelector('.fs-btn');
      if (fsBtn) {fsBtn.textContent='⛶';fsBtn.classList.remove('exit');fsBtn.title='全屏';}
    }
    // 进入横屏
    wrapper.classList.add('is-landscape');
    btn.textContent = '⇋';btn.classList.add('active');btn.title = '退出横屏';
    // 视频开始播放
    const video = wrapper.querySelector('.video-player');
    if (video && video.paused) {video.play();}
  }
}

/* 监听屏幕方向变化，自动适配 */
window.addEventListener('orientationchange', function(){
  setTimeout(() => {
    const isLandscape = window.innerWidth > window.innerHeight;
    document.querySelectorAll('.video-wrapper.is-landscape').forEach(w => {
      if (isLandscape) {
        // 设备横屏时，移除模拟横屏，改为自适应
        w.classList.remove('is-landscape');
        const btn = w.querySelector('.ls-btn');
        if (btn) {btn.textContent='⇋';btn.classList.remove('active');btn.title='横屏播放';}
      }
    });
  }, 300);
});

/* ===== 返回首页 ===== */
function goHome(){
  player.pause();
  document.querySelectorAll('.video-player').forEach(v => v.pause());
  showView('view-home');
}

/* ===== 返回目录 ===== */
function backToCatalog(){
  player.pause();
  document.querySelectorAll('.video-player').forEach(v => v.pause());
  renderCatalogList();
  showView('view-catalog');
}

/* ===== 邀请码系统 ===== */
