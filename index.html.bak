    {
      "poem": "渔歌子·西塞山前白鹭飞",
      "author": "张志和",
      "dynasty": "唐",
      "audios": [],
      "videos": [],
      "content": "西塞山前白鹭飞，桃花流水鳜鱼肥。\n青箬笠，绿蓑衣，斜风细雨不须归。"
    },
    {
      "poem": "塞下曲·月黑雁飞高",
      "author": "卢纶",
      "dynasty": "唐",
      "audios": [],
      "videos": [],
      "content": "月黑雁飞高，单于夜遁逃。\n欲将轻骑逐，大雪满弓刀。"
    },
    {
      "poem": "题西林壁",
      "author": "苏轼",
      "dynasty": "宋",
      "audios": [],
      "videos": [],
      "content": "横看成岭侧成峰，远近高低各不同。\n不识庐山真面目，只缘身在此山中。"
    },
    {
      "poem": "饮湖上初晴后雨",
      "author": "苏轼",
      "dynasty": "宋",
      "audios": [],
      "videos": [],
      "content": "水光潋滟晴方好，山色空蒙雨亦奇。\n欲把西湖比西子，淡妆浓抹总相宜。"
    },
    {
      "poem": "春日",
      "author": "朱熹",
      "dynasty": "宋",
      "audios": [],
      "videos": [],
      "content": "胜日寻芳泗水滨，无边光景一时新。\n等闲识得东风面，万紫千红总是春。"
    },
    {
      "poem": "观书有感·半亩方塘一鉴开",
      "author": "朱熹",
      "dynasty": "宋",
      "audios": [],
      "videos": [],
      "content": "半亩方塘一鉴开，天光云影共徘徊。\n问渠那得清如许？为有源头活水来。"
    },
    {
      "poem": "四时田园杂兴·昼出耘田夜绩麻",
      "author": "范成大",
      "dynasty": "宋",
      "audios": [],
      "videos": [],
      "content": "昼出耘田夜绩麻，村庄儿女各当家。\n童孙未解供耕织，也傍桑阴学种瓜。"
    },
    {
      "poem": "乐游原",
      "author": "李商隐",
      "dynasty": "唐",
      "audios": [],
      "videos": [],
      "content": "向晚意不适，驱车登古原。\n夕阳无限好，只是近黄昏。"
    },
    {
      "poem": "登飞来峰",
      "author": "王安石",
      "dynasty": "宋",
      "audios": [],
      "videos": [],
      "content": "飞来山上千寻塔，闻说鸡鸣见日升。\n不畏浮云遮望眼，自缘身在最高层。"
    },
    {
      "poem": "别董大",
      "author": "高适",
      "dynasty": "唐",
      "content": "千里黄云白日曛，\n北风吹雁雪纷纷。\n莫愁前路无知己，\n天下谁人不识君。",
      "audios": [],
      "videos": []
    },
    {
      "poem": "塞下曲",
      "author": "卢纶",
      "dynasty": "唐",
      "content": "月黑雁飞高，\n单于夜遁逃。\n欲将轻骑逐，\n大雪满弓刀。",
      "audios": [],
      "videos": []
    },
    {
      "poem": "嫦娥",
      "author": "李商隐",
      "dynasty": "唐",
      "content": "云母屏风烛影深，\n长河渐落晓星沉。\n嫦娥应悔偷灵药，\n碧海青天夜夜心。",
      "audios": [],
      "videos": []
    },
    {
      "poem": "宿新市徐公店",
      "author": "杨万里",
      "dynasty": "宋",
      "content": "篱落疏疏一径深，\n树头新绿未成阴。\n儿童急走追黄蝶，\n飞入菜花无处寻。",
      "audios": [],
      "videos": []
    },
    {
      "poem": "江畔独步寻花",
      "author": "杜甫",
      "dynasty": "唐",
      "content": "黄师塔前江水东，\n春光懒困倚微风。\n桃花一簇开无主，\n可爱深红爱浅红。",
      "audios": [],
      "videos": []
    },
    {
      "poem": "蜂",
      "author": "罗隐",
      "dynasty": "唐",
      "content": "不论平地与山尖，\n无限风光尽被占。\n采得百花成蜜后，\n为谁辛苦为谁甜。",
      "audios": [],
      "videos": []
    }
  ],
